@model Category

<form method="post">
    <input asp-for="Id" type="hidden" />

    <div class="card shadow border-0 mt-4">
        <div class="card-header bg-warning bg-gradient py-3">
            <h2 class="text-white text-center m-0">Edit Category</h2>
        </div>

        <div class="card-body p-4">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DisplayOrder" class="form-label"></label>
                <input asp-for="DisplayOrder" class="form-control" />
                <span asp-validation-for="DisplayOrder" class="text-danger"></span>
            </div>

            <div class="row mt-4">
                <div class="col-6 col-md-3 mb-2">
                    <button type="submit" class="btn btn-primary w-100">Update</button>
                </div>
                <div class="col-6 col-md-3 mb-2">
                    <a asp-controller="Category" asp-action="Index" class="btn btn-secondary w-100">
                        Back to List
                    </a>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
